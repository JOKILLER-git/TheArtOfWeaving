[node name="KnitLevel2D" type="Control"]
editor_description = "2D 针织关卡：从下往上钩过线圈的眼 = 成针；线头绕锚点一圈 = 切换线的前后；把左下角的剪刀拖到线或织物上 = 剪断重来。完成后出现星级，自动请求下一关。快捷键 R 剪断 / H 提示 / N 跳过星级。F6 单独运行时玩 default_level；完整流程见 scenes/app/game_app.tscn。"
custom_minimum_size = Vector2(1280, 800)
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("3_theme")
script = ExtResource("1_level")
default_level = ExtResource("2_level")

